# find modules in repository: https://registry.bazel.build/modules/
bazel_dep(name = "gazelle", version = "0.45.0")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "rules_proto_grpc_go", version = "5.0.1")
bazel_dep(name = "rules_java", version = "8.14.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.2.0.2")
bazel_dep(name = "protobuf", version = "33.0")
bazel_dep(name = "jq.bzl", version = "0.4.0")

jq_toolchains_ext = use_extension("@jq.bzl//jq:extensions.bzl", "toolchains")
use_repo(jq_toolchains_ext, "jq_toolchains")

register_toolchains("@jq_toolchains//:all")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.module_override(
    patch_strip = 1,
    patches = ["//thirdparty/patches:confluent_kafka_vendor.patch"],
    path = "github.com/confluentinc/confluent-kafka-go/v2",
)

#go_deps.module(
#    path = "google.golang.org/grpc",
#    sum = "h1:OgPcDAFKHnH8X3O4WcO4XUc8GRDeKsKReqbQtiCj7N8=",
#    version = "v1.67.3",
#)

# All *direct* Go dependencies of the module have to be listed explicitly.
use_repo(
    go_deps,
    "com_github_confluentinc_confluent_kafka_go_v2",
    "com_github_dropbox_godropbox",
    "com_github_google_uuid",
    "com_github_gorilla_mux",
    "com_github_prometheus_client_golang",
    "com_github_stretchr_testify",
    "com_github_twmb_franz_go",
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_exporters_prometheus",
    "io_opentelemetry_go_otel_exporters_stdout_stdoutlog",
    "io_opentelemetry_go_otel_exporters_stdout_stdouttrace",
    "io_opentelemetry_go_otel_log",
    "io_opentelemetry_go_otel_metric",
    "io_opentelemetry_go_otel_sdk",
    "io_opentelemetry_go_otel_sdk_log",
    "io_opentelemetry_go_otel_sdk_metric",
    "io_opentelemetry_go_otel_trace",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_uber_go_zap",
)

bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "container_structure_test", version = "1.19.1")
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "aspect_bazel_lib", version = "2.21.2")

##########################
# Container images
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.toolchains(name = "wolvekafka")
oci.pull(
    name = "distroless_base",
    digest = "sha256:ccaef5ee2f1850270d453fdf700a5392534f8d1a8ca2acda391fbb6a06b81c86",
    image = "gcr.io/distroless/base",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
oci.pull(
    name = "ubuntu",
    digest = "sha256:80dd3c3b9c6cecb9f1667e9290b3bc61b78c2678c02cbdae5f0fea92cc6734ab",
    image = "ubuntu",
    platforms = [
        "linux/arm64/v8",
        "linux/amd64",
    ],
    tag = "latest",
)
use_repo(oci, "distroless_base", "distroless_base_linux_amd64", "distroless_base_linux_arm64", "ubuntu", "ubuntu_linux_amd64", "ubuntu_linux_arm64_v8")
use_repo(oci, "wolvekafka_crane_toolchains", "wolvekafka_regctl_toolchains")

register_toolchains("@wolvekafka_crane_toolchains//:all", "@wolvekafka_regctl_toolchains//:all")
