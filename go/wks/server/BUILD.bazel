load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//go/wks/bazel_util:oci_push_do.bzl", "oci_push_do")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "wolvekafka/go/wks/server",
    visibility = ["//visibility:private"],
    deps = [
        "//go/common/logger",
        "//go/common/server",
        "//go/configs",
        "//go/wks",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "server_linux_amd64",
    embed = [":server_lib"],
    goarch = "amd64",
    goos = "linux",
    visibility = ["//visibility:private"],
)

# Package the binary into a tar layer.
pkg_tar(
    name = "wks_layer",
    srcs = [":server_linux_amd64"],
    package_dir = "/usr/local/bin",
    symlinks = {
        "/usr/local/bin/server": "/usr/local/bin/server_linux_amd64",
    },
)

# Build OCI image.
oci_image(
    name = "wks_image",
    base = "@distroless_base",
    entrypoint = ["/usr/local/bin/server"],
    tars = [":wks_layer"],
    visibility = ["//visibility:public"],
)

# Docker-loadable tarball for local development (minikube, kind, etc.)
# Usage: bazel build //go/wks/server:local_image --output_groups=+tarball
#        minikube image load bazel-bin/go/wks/server/local_image/tarball.tar
oci_load(
    name = "local_image",
    image = ":wks_image",
    repo_tags = ["registry.digitalocean.com/wolveflake/wks:latest"],
)

# Push to Digital Ocean container registry.
oci_push_do(
    name = "push",
    image = ":wks_image",
    remote_tags = ["latest"],
    repository = "registry.digitalocean.com/wolveflake/wks",
)
