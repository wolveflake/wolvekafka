load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:pkg.bzl", "pkg_tar")
load("//go/wks/server:oci_push_do.bzl", "oci_push_do")

exports_files(["do_push.sh.tpl"])

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "wolvekafka/go/wks/server",
    visibility = ["//visibility:private"],
    deps = [
        "//go/common/logger",
        "//go/common/server",
        "//go/configs",
        "//go/wks",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "server_rootfs_files",
    srcs = [":server_image_binary"],
    attributes = pkg_attributes(mode = "0755"),
    renames = {":server_image_binary": "server"},
    strip_prefix = strip_prefix.files_only(),
    visibility = ["//visibility:private"],
)

pkg_tar(
    name = "server_rootfs",
    srcs = [":server_rootfs_files"],
    out = "server_rootfs.tar",
    visibility = ["//visibility:private"],
)

genrule(
    name = "server_image_binary",
    srcs = [":server"],
    outs = ["server_image_binary_bin"],
    cmd = "cp $< $@ && chmod 0755 $@",
    visibility = ["//visibility:private"],
)

# Build the image
oci_image(
    name = "image",
    base = "@ubuntu//:ubuntu",
    # Entrypoint
    entrypoint = ["/server"],
    # Layers to add to the base image
    tars = [":server_rootfs"],
    visibility = ["//visibility:public"],
)

# Push the image. The push rules stay in the host configuration so that the helper
# binaries (crane/jq) chosen by rules_oci remain executable on macOS. The actual
# container layers are transitioned to Linux via the filegroups defined below, so
# no --platforms flag is required when running these targets.
oci_push_do(
    name = "image_push",
    image = ":transitioned_image_linux_amd64",
    # tag(s) as a list
    remote_tags = ["latest"],
    repository = "registry.digitalocean.com/wolveflake/wks",
)

oci_push_do(
    name = "image_push_arm64",
    image = ":transitioned_image_linux_arm64",
    # tag(s) as a list
    remote_tags = ["latest"],
    repository = "registry.digitalocean.com/wolveflake/wks",
    visibility = ["//visibility:public"],
)

oci_push_do(
    name = "image_push_ghcr",
    image = ":transitioned_image_linux_amd64",
    # tag(s) as a list
    remote_tags = ["latest"],
    repository = "ghcr.io/wolveflake/wks",
)

oci_push_do(
    name = "image_push_ghcr_arm64",
    image = ":transitioned_image_linux_arm64",
    # tag(s) as a list
    remote_tags = ["latest"],
    repository = "ghcr.io/wolveflake/wks",
    visibility = ["//visibility:public"],
)

# This is the target that should be released to the target platform
platform_transition_filegroup(
    name = "transitioned_image_linux_amd64",
    srcs = [":image"],
    target_platform = "@rules_go//go/toolchain:linux_amd64",
)

platform_transition_filegroup(
    name = "transitioned_image_linux_arm64",
    srcs = [":image"],
    target_platform = "@rules_go//go/toolchain:linux_arm64",
)
