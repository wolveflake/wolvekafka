load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//go/lambda/bazel_util:oci_push_do.bzl", "oci_push_do")

go_library(
    name = "server_lib",
    srcs = [
        "main.go",
        "producer_handler.go",
    ],
    embedsrcs = [
        "landing/assets/bootstrap/css/bootstrap.min.css",
        "landing/assets/bootstrap/js/bootstrap.min.js",
        "landing/assets/css/Footer-Basic-icons.css",
        "landing/assets/css/iframe.css",
        "landing/assets/img/wolveflak_io_transparent.png",
        "landing/assets/img/wolveflake_io.png",
        "landing/assets/img/wolveflake_io_banner.jpg",
        "landing/assets/js/js.js",
        "landing/index.html",
    ],
    importpath = "wolvekafka/go/lambda/server",
    visibility = ["//visibility:private"],
    deps = [
        "//go/common/logger",
        "//go/lambda",
        "//proto/model",
        "@com_github_google_uuid//:uuid",
        "@com_github_twmb_franz_go//pkg/kgo",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "server_linux_amd64",
    embed = [":server_lib"],
    goarch = "amd64",
    goos = "linux",
    visibility = ["//visibility:private"],
)

# Package the binary into a tar layer.
pkg_tar(
    name = "lambda_layer",
    srcs = [":server_linux_amd64"],
    package_dir = "/usr/local/bin",
    symlinks = {
        "/usr/local/bin/server": "/usr/local/bin/server_linux_amd64",
    },
)

# Build OCI image.
oci_image(
    name = "lambda_image",
    base = "@distroless_base",
    entrypoint = ["/usr/local/bin/server"],
    tars = [":lambda_layer"],
    visibility = ["//visibility:public"],
)

# Docker-loadable tarball for local development (minikube, kind, etc.)
# Usage: bazel build //go/lambda/server:local_image --output_groups=+tarball
#        minikube image load bazel-bin/go/lambda/server/local_image/tarball.tar
oci_load(
    name = "local_image",
    image = ":lambda_image",
    repo_tags = ["registry.digitalocean.com/wolveflake/lambda:latest"],
)

# Push to Digital Ocean container registry.
oci_push_do(
    name = "push",
    image = ":lambda_image",
    remote_tags = ["latest"],
    repository = "registry.digitalocean.com/wolveflake/lambda",
)
